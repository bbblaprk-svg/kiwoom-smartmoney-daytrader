FROM python:3.12-slim-bookworm
ARG BUILD_GIT_SHA=recheck-20260831
ARG BUILD_CREATED_AT=2026-08-31T09:25:00Z
LABEL org.opencontainers.image.title="NOVA HYBRID DISCOVERY V3 SIGNAL MANAGEMENT RECHECK" \
      org.opencontainers.image.version="NOVA-HYBRID-DISCOVERY-V3-SIGNAL-MANAGEMENT-3.3.2-RECHECK" \
      org.opencontainers.image.revision="${BUILD_GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_CREATED_AT}" \
      io.quantnova.deploy_model="LIGHTSAIL_SAFE_CUTOVER" \
      io.quantnova.package_model="SINGLE_DOCKERFILE_EMBEDDED_SOURCE" \
      io.quantnova.market_venues="KRX_NXT" \
      io.quantnova.fixed_six_tables="TRUE" \
      io.quantnova.signal_management="5_TRADING_DAYS_VIEW20_MAX1000" \
      io.quantnova.primary_next_ui="HIDDEN_VERIFY_ONLY" \
      io.quantnova.automatic_order="FALSE" \
      io.quantnova.new_broker_calls="0" \
      io.quantnova.new_ws_types="0" \
      io.quantnova.entry_policy_sha256="18cb96ef1afb9de48136d39c3e9b8216e62a94dccf0229aa027479783eb9151a" \
      io.quantnova.kiwoom_sha256="e10d936a2540a70d8a488e0460608a3c2a1a8bfaf95dc6206e706cce3afab0d1" \
      io.quantnova.websocket_sha256="50f6fe15df09876bb29aca8c594fb4e239488561e13374487fd65604d19c044a" \
      io.quantnova.service_sha256="70290e46a897a1322ebd4747540f4cebcdcd26fb74e0cf07ff845dd63a7560f1" \
      io.quantnova.embedded_source_tar_sha256="caef877f3f0efbed6ab2aab5b8fca62ec0f19e25d12780f0662345de8afa2f03"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 NOVA_DATA_DIR=/app/data/nova30 NOVA_LEGACY_DATA_DIR=/app/data NOVA_HYBRID_V3_OFFICIAL_CUTOVER=true
WORKDIR /app
RUN mkdir -p /app/data/nova30 /app/data/nova30/legacy_bridge
RUN printf '%s' '' > /tmp/nova-source.tar.gz.b64
RUN python - <<'PY'
import base64,hashlib,pathlib
p=pathlib.Path('/tmp/nova-source.tar.gz.b64'); b=base64.b64decode(p.read_bytes())
assert hashlib.sha256(b).hexdigest()=='caef877f3f0efbed6ab2aab5b8fca62ec0f19e25d12780f0662345de8afa2f03'
pathlib.Path('/tmp/nova-source.tar.gz').write_bytes(b)
PY
RUN tar -xzf /tmp/nova-source.tar.gz -C /app && rm -f /tmp/nova-source.tar.gz /tmp/nova-source.tar.gz.b64
RUN python -m pip install --requirement /app/requirements.txt
RUN python -m compileall -q /app/app /app/scripts && \
    PYTHONPATH=/app python /app/scripts/precision_test_suite.py && \
    PYTHONPATH=/app python /app/scripts/precision_edge_x1_acceptance.py && \
    PYTHONPATH=/app python /app/scripts/precision_edge_phase2_acceptance.py && \
    PYTHONPATH=/app python /app/scripts/chart_edge_fix9_acceptance.py && \
    PYTHONPATH=/app python /app/scripts/hybrid_v3_full_acceptance.py && \
    PYTHONPATH=/app python /app/scripts/signal_management_5d_acceptance.py && \
    PYTHONPATH=/app python /app/scripts/validate.py --quick
HEALTHCHECK --interval=15s --timeout=4s --start-period=35s --retries=3 CMD python -c "import json,urllib.request,sys; j=json.load(urllib.request.urlopen('http://127.0.0.1:8000/api/livez',timeout=2)); sys.exit(0 if j.get('ok') else 1)"
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1","--log-level","info","--access-log"]
