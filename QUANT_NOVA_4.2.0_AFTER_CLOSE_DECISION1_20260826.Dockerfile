RUN python -c "import base64,hashlib,pathlib; p=pathlib.Path('/tmp/nova-after-close-source.tar.gz.b64'); raw=base64.b64decode(p.read_bytes(),validate=True); actual=hashlib.sha256(raw).hexdigest(); expected='74e87882198b1cca495f657dfee6183d867dff250de0c01c11f6088e63d10a82'; assert actual==expected,(actual,expected); pathlib.Path('/tmp/nova-after-close-source.tar.gz').write_bytes(raw); print('AFTER_CLOSE_SOURCE_SHA256='+actual)" && rm -f /tmp/nova-after-close-source.tar.gz.b64
RUN python -c "import tarfile; a=tarfile.open('/tmp/nova-after-close-source.tar.gz','r:gz'); ms=a.getmembers(); bad=[m.name for m in ms if m.name.replace(chr(92),'/').startswith('/') or '..' in m.name.replace(chr(92),'/').split('/') or m.isdev() or m.issym() or m.islnk()]; assert not bad,bad; a.extractall('/app'); print('AFTER_CLOSE_SOURCE_EXTRACT=PASS',len(ms))" && rm -f /tmp/nova-after-close-source.tar.gz
RUN cd /app && sha256sum -c SOURCE_MANIFEST.sha256
RUN test "$(sha256sum /app/app/signal/policy.py | awk '{print $1}')" = "18cb96ef1afb9de48136d39c3e9b8216e62a94dccf0229aa027479783eb9151a" && \
    test "$(sha256sum /app/app/broker/kiwoom.py | awk '{print $1}')" = "e10d936a2540a70d8a488e0460608a3c2a1a8bfaf95dc6206e706cce3afab0d1" && \
    test "$(sha256sum /app/app/broker/websocket.py | awk '{print $1}')" = "50fefc5faa1457210af758636279bea0bc3926e505bc91317962a0d451e35602" && \
    test "$(sha256sum /app/app/broker/discovery.py | awk '{print $1}')" = "7035a5b5c90a23324c44d80eb3c0c278f75c5d73d8fed2a01cc367a03c35cb86" && \
    test "$(sha256sum /app/app/service.py | awk '{print $1}')" = "e325b7a76d6ddfa291b800ef97fb13e6b85fa9bb9ccb2365130ef2d5abf512c3" && \
    test "$(sha256sum /app/app/runtime/ingest.py | awk '{print $1}')" = "fdcefa5b9f2a9a57564cfcd30cdb2be703c7662e3a18598c2131cb3d7e61c10b" && \
    test "$(sha256sum /app/app/runtime/state.py | awk '{print $1}')" = "28e835a781ed4a0a00bf4ab1fb1f2dcfb6c3c23ed77750c492788a168c80451b" && \
    test "$(sha256sum /app/app/signal/metrics.py | awk '{print $1}')" = "8b724c482124f2ef117a490280161423f884444f60eac7e7601804f59c041927"
RUN python -m pip install --requirement /app/requirements.txt
RUN python -m compileall -q /app/app /app/scripts && \
    PYTHONPATH=/app python -m unittest discover -s /app/tests -q && \
    PYTHONPATH=/app python /app/scripts/clean_rebuild_acceptance.py && \
    PYTHONPATH=/app python /app/scripts/after_close_decision_acceptance.py
HEALTHCHECK --interval=15s --timeout=4s --start-period=35s --retries=3 CMD python -c "import json,urllib.request,sys; j=json.load(urllib.request.urlopen('http://127.0.0.1:8000/api/livez',timeout=2)); sys.exit(0 if j.get('ok') else 1)"
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1","--log-level","info","--access-log"]
