NOVA_KIWOOM_332_SWING_PRE_R1_SOURCE_B64

RUN python - <<'PY_EXTRACT'
from pathlib import Path
import base64,hashlib,shutil,zipfile
expected='51b8dbf78a3415136670effe5412fe5e280063d1c3160e2bdb3004578e4918a7'
b64=Path('/tmp/nova-source.zip.b64').read_bytes()
data=base64.b64decode(b64)
got=hashlib.sha256(data).hexdigest()
if got != expected:
    raise SystemExit(f'embedded source SHA mismatch: {got} != {expected}')
zp=Path('/tmp/nova-source.zip');zp.write_bytes(data)
tmp=Path('/tmp/nova-src');shutil.rmtree(tmp,ignore_errors=True);tmp.mkdir()
with zipfile.ZipFile(zp) as z:
    bad=z.testzip()
    if bad: raise SystemExit('ZIP CRC fail: '+bad)
    names=z.namelist()
    if not names: raise SystemExit('empty embedded source')
    roots={n.split('/',1)[0] for n in names if '/' in n}
    if len(roots)!=1: raise SystemExit('unexpected source root')
    if any(n.startswith('/') or '..' in Path(n).parts for n in names): raise SystemExit('unsafe ZIP path')
    z.extractall(tmp)
root=tmp/next(iter(roots))
for p in root.iterdir():
    dst=Path('/app')/p.name
    if p.is_dir(): shutil.copytree(p,dst,dirs_exist_ok=True)
    else: shutil.copy2(p,dst)
Path('/tmp/nova-source.zip.b64').unlink(missing_ok=True);zp.unlink(missing_ok=True);shutil.rmtree(tmp,ignore_errors=True)
PY_EXTRACT

RUN python -m pip install --requirement /app/requirements.txt
RUN cd /app && sha256sum -c SOURCE_MANIFEST.sha256 && \
    python -m compileall -q /app/app /app/scripts && \
    PYTHONPATH=/app python -m unittest discover -s /app/tests -v && \
    PYTHONPATH=/app python /app/scripts/image_contract.py /app && \
    PYTHONPATH=/app python /app/scripts/master_audit.py && \
    PYTHONPATH=/app python /app/scripts/validate.py --quick

HEALTHCHECK --interval=15s --timeout=4s --start-period=35s --retries=3 \
  CMD python -c "import json,urllib.request,sys; j=json.load(urllib.request.urlopen('http://127.0.0.1:8000/api/livez',timeout=2)); sys.exit(0 if j.get('ok') else 1)"
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1","--log-level","info","--access-log"]
