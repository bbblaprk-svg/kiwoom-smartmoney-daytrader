# syntax=docker/dockerfile:1.7
# QUANT NOVA 3.3.2 · KIWOOM SWING + PRE-IGNITION R1 · LEGACY BUILDER FIX
# Base data-acquisition, broker, websocket, recovery, venue-truth, and ENTRY_V18 files are frozen to the verified Kiwoom 3.3.2 source.
FROM python:3.12-slim-bookworm

ARG BUILD_GIT_SHA=unknown
ARG BUILD_CREATED_AT=unknown
LABEL org.opencontainers.image.title="QUANT NOVA" \
      org.opencontainers.image.version="NOVA-3.3.2-MASTER-TOP10-LIVEFIX" \
      org.opencontainers.image.revision="${BUILD_GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_CREATED_AT}" \
      org.opencontainers.image.source="https://github.com/bbblaprk-svg/kiwoom-smartmoney-daytrader" \
      io.quantnova.patch="KIWOOM_SWING_PREIGNITION_R1_LEGACYFIX" \
      io.quantnova.data_feed="KIWOOM_3.3.2_FROZEN" \
      io.quantnova.embedded_source_sha256="51b8dbf78a3415136670effe5412fe5e280063d1c3160e2bdb3004578e4918a7" \
      io.quantnova.deploy_model="SINGLE_DOCKERFILE_EMBEDDED_SOURCE_LEGACY_COMPAT" \
      io.quantnova.runtime_profile="LIGHTSAIL_1GB_BOUNDED"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    NOVA_DATA_DIR=/app/data/nova30 \
    NOVA_LEGACY_DATA_DIR=/app/data

WORKDIR /app
RUN mkdir -p /app/data/nova30 /app/data/nova30/legacy_bridge

RUN : > /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN test "$(wc -c < /tmp/nova-source.zip.b64 | tr -d ' ')" = "218488"
RUN python -c "from pathlib import Path; import base64,hashlib,shutil,zipfile; expected='51b8dbf78a3415136670effe5412fe5e280063d1c3160e2bdb3004578e4918a7'; b64=Path('/tmp/nova-source.zip.b64').read_bytes(); data=base64.b64decode(b64); got=hashlib.sha256(data).hexdigest(); assert got==expected, f'embedded source SHA mismatch: {got} != {expected}'; zp=Path('/tmp/nova-source.zip'); zp.write_bytes(data); tmp=Path('/tmp/nova-src'); shutil.rmtree(tmp,ignore_errors=True); tmp.mkdir(); z=zipfile.ZipFile(zp); bad=z.testzip(); assert bad is None, 'ZIP CRC fail: '+str(bad); names=z.namelist(); assert names, 'empty embedded source'; roots={n.split('/',1)[0] for n in names if '/' in n}; assert len(roots)==1, 'unexpected source root'; assert not any(n.startswith('/') or '..' in Path(n).parts for n in names), 'unsafe ZIP path'; z.extractall(tmp); z.close(); root=tmp/next(iter(roots)); [(shutil.copytree(p,Path('/app')/p.name,dirs_exist_ok=True) if p.is_dir() else shutil.copy2(p,Path('/app')/p.name)) for p in root.iterdir()]; Path('/tmp/nova-source.zip.b64').unlink(missing_ok=True); zp.unlink(missing_ok=True); shutil.rmtree(tmp,ignore_errors=True)"

RUN python -m pip install --requirement /app/requirements.txt
RUN cd /app && sha256sum -c SOURCE_MANIFEST.sha256 && \
    python -m compileall -q /app/app /app/scripts && \
    PYTHONPATH=/app python -m unittest discover -s /app/tests -v && \
    PYTHONPATH=/app python /app/scripts/image_contract.py /app && \
    PYTHONPATH=/app python /app/scripts/master_audit.py && \
    PYTHONPATH=/app python /app/scripts/validate.py --quick

HEALTHCHECK --interval=15s --timeout=4s --start-period=35s --retries=3 \
  CMD python -c "import json,urllib.request,sys; j=json.load(urllib.request.urlopen('http://127.0.0.1:8000/api/livez',timeout=2)); sys.exit(0 if j.get('ok') else 1)"
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1","--log-level","info","--access-log"]
