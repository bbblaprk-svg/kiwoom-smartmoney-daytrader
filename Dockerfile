FROM python:3.12-slim-bookworm
ARG NOVA_SOURCE_SHA256=64a67ca5e6097af2933dd2f88272310c841641b1e365682642fb3349e36ae918
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 NOVA_DATA_DIR=/app/data/nova40
WORKDIR /app
RUN : > /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN printf '%s' '' >> /tmp/nova-source.tar.gz.b64
RUN base64 -d /tmp/nova-source.tar.gz.b64 > /tmp/nova-source.tar.gz \
 && echo "${NOVA_SOURCE_SHA256}  /tmp/nova-source.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/nova-source.tar.gz -C /app \
 && rm -f /tmp/nova-source.tar.gz /tmp/nova-source.tar.gz.b64 \
 && sha256sum -c SOURCE_MANIFEST.sha256
RUN pip install --no-cache-dir -r requirements.txt
RUN python -m compileall -q app tests scripts \
 && PYTHONPATH=. python -m unittest discover -s tests -v \
 && python scripts/validate.py
LABEL org.opencontainers.image.title="QUANT NOVA" \
      org.opencontainers.image.version="NOVA-4.0.0-GROUNDUP-EARLY-EDGE" \
      io.quantnova.architecture="GROUNDUP_EARLY_EDGE_V1" \
      io.quantnova.embedded_source_sha256="64a67ca5e6097af2933dd2f88272310c841641b1e365682642fb3349e36ae918" \
      io.quantnova.reference_dockerfile_sha256="246deb1bd45854af17ab5c7ed80652bebabb576270ee1ac5b47866401a49ea45" \
      io.quantnova.new_discovery_rest_types="0" \
      io.quantnova.new_ws_types="0" \
      io.quantnova.order_execution="DISABLED_NO_ORDER_ENDPOINT"
EXPOSE 3200
HEALTHCHECK --interval=5s --timeout=3s --start-period=12s --retries=12 CMD python -c "import json,os,urllib.request; p=os.getenv('PORT','3200'); j=json.load(urllib.request.urlopen('http://127.0.0.1:'+p+'/api/readyz',timeout=2)); assert j.get('ok')" || exit 1
CMD ["sh","-c","uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-3200} --workers 1"]
