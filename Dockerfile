RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN printf '%s' '' >> /tmp/nova-source.zip.b64
RUN test "$(wc -c < /tmp/nova-source.zip.b64 | tr -d ' ')" = "220436"
RUN python -c "from pathlib import Path; import base64,hashlib,shutil,zipfile; expected='b877d64bd3f9727beb382de6b9329cb7669ac07396820f5388b8e58e70e7829c'; b64=Path('/tmp/nova-source.zip.b64').read_bytes(); data=base64.b64decode(b64); got=hashlib.sha256(data).hexdigest(); assert got==expected, f'embedded source SHA mismatch: {got} != {expected}'; zp=Path('/tmp/nova-source.zip'); zp.write_bytes(data); tmp=Path('/tmp/nova-src'); shutil.rmtree(tmp,ignore_errors=True); tmp.mkdir(); z=zipfile.ZipFile(zp); bad=z.testzip(); assert bad is None, 'ZIP CRC fail: '+str(bad); names=z.namelist(); roots={n.split('/',1)[0] for n in names if '/' in n}; assert len(roots)==1, 'unexpected source root'; assert not any(n.startswith('/') or '..' in Path(n).parts for n in names), 'unsafe ZIP path'; z.extractall(tmp); z.close(); root=tmp/next(iter(roots)); [(shutil.copytree(p,Path('/app')/p.name,dirs_exist_ok=True) if p.is_dir() else shutil.copy2(p,Path('/app')/p.name)) for p in root.iterdir()]; Path('/tmp/nova-source.zip.b64').unlink(missing_ok=True); zp.unlink(missing_ok=True); shutil.rmtree(tmp,ignore_errors=True)"

RUN python -m pip install --requirement /app/requirements.txt
RUN cd /app && sha256sum -c SOURCE_MANIFEST.sha256 && \
    python -m compileall -q /app/app /app/scripts && \
    PYTHONPATH=/app python -m unittest discover -s /app/tests -v && \
    PYTHONPATH=/app python /app/scripts/image_contract.py /app && \
    PYTHONPATH=/app python /app/scripts/master_audit.py && \
    PYTHONPATH=/app python /app/scripts/validate.py --quick

HEALTHCHECK --interval=15s --timeout=4s --start-period=35s --retries=3 \
  CMD python -c "import json,urllib.request,sys; j=json.load(urllib.request.urlopen('http://127.0.0.1:8000/api/livez',timeout=2)); sys.exit(0 if j.get('ok') else 1)"
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1","--log-level","info","--access-log"]
