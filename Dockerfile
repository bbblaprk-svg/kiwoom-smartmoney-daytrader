expected = "2d850dc8cc7237bbf553f353bfb96e2ffa037f7bacbf6e848e180c65fe0e2e57"
actual = hashlib.sha256(raw).hexdigest()
if actual != expected:
    raise SystemExit(f"embedded bundle sha256 mismatch: {actual} != {expected}")
with tarfile.open(fileobj=io.BytesIO(raw), mode='r:gz') as archive:
    for member in archive.getmembers():
        name = member.name.replace('\\','/')
        if name.startswith('/') or '..' in name.split('/') or member.isdev() or member.issym() or member.islnk():
            raise SystemExit(f"unsafe archive member: {member.name}")
    archive.extractall('/app', filter='data')
print('EMBEDDED_SOURCE_SHA256=' + actual)
